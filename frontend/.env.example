# フロントエンド環境変数の設定例
# .env.development、.env.staging、.env.productionへコピーし、対象環境の値に置き換える。
# 値はブラウザへ公開されるため、秘密情報を設定しない。
VITE_APP_NAME=iseeetl

# APIの公開URL。同一オリジンで利用する場合は空にする。
VITE_APP_URL=https://app.example.com

# 公開IDの設定例。連携を利用しない場合は空にする。
VITE_ONESIGNAL_APP_ID=00000000-0000-4000-8000-000000000000

# Googleログイン
VITE_GOOGLE_OAUTH_CLIENT_ID=000000000000-example.apps.googleusercontent.com
