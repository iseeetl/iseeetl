# E2E環境変数の設定例。.env.e2eへコピーして使用する。
# .env.e2eはGit管理外。既存ファイルは上書きしない。
# 手順: docs/testing/e2e-testing.md（リポジトリルートからのパス）
# アプリ名は変更可能。URL・ポート・転送先は固定で、外部連携の公開IDは空にする。
# このファイルには秘密値を設定しない。DB・保存先の準備はバックエンド側の手順に従う。

VITE_APP_NAME=iSeeEtl E2E
VITE_APP_URL=http://localhost:3100
VITE_ONESIGNAL_APP_ID=
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_SERVER_PORT=3100
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:5100
