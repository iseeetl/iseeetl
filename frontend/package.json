{
  "name": "iseeetl-frontend",
  "version": "2.0.4",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "serve": "vite --mode development",
    "build:e2e": "vite build --mode e2e",
    "serve:e2e": "npm run build:e2e && vite preview --mode e2e",
    "build:development": "node scripts/vue3-build.mjs --mode development",
    "build:staging": "node scripts/vue3-build.mjs --mode staging",
    "build:production": "node scripts/vue3-build.mjs --mode production",
    "lint": "eslint src tests scripts vite.config.js vitest.config.mjs",
    "test:unit": "vitest",
    "test:unit:ci": "CI=1 vitest run --reporter=dot",
    "test:unit:verbose": "CI=1 vitest run --reporter=verbose",
    "test:build": "node tests/build-integration/frontend-build-integration.mjs",
    "test:e2e": "node --require ./scripts/preload-e2e-account-environment.js ./node_modules/nightwatch/bin/nightwatch --config nightwatch.config.js --env chrome --serial"
  },
  "dependencies": {
    "@vuelidate/core": "2.0.3",
    "@vuelidate/validators": "2.0.4",
    "axios": "1.19.0",
    "blueimp-load-image": "2.31.0",
    "dompurify": "3.4.12",
    "socket.io-client": "4.8.3",
    "splitpanes": "4.1.2",
    "velocity-animate": "1.5.2",
    "vue": "3.5.40",
    "vue-i18n": "11.4.8",
    "vue-router": "5.2.0",
    "vuedraggable": "4.1.0",
    "vuex": "4.1.0",
    "wavesurfer.js": "7.12.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/compiler-dom": "3.5.40",
    "@vue/compiler-sfc": "3.5.40",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "nightwatch": "3.16.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "nightwatch": {
      "mocha": {
        "serialize-javascript": "7.0.5"
      }
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ]
}
