# E2E環境変数の設定例
# .env.e2eへコピーし、DB接続先のホスト・ポートを自分のE2E環境に合わせる。
# .env.e2eはGit管理外。既存ファイルは上書きしない。
# 通常開発・ステージング・本番の設定や、実在する利用者・外部サービスの認証情報は使わない。
# 固定と記載した項目は変更せず、必要なサービスとディレクトリを用意する。
# 手順: docs/testing/e2e-testing.md（リポジトリルートからのパス）
# コピー先の.env.e2eを専用ローダーが読み込み、DB・ポート・保存先・外部機能を検証する。

# バックエンドの動作モード（E2Eではdevelopment固定）
NODE_ENV=development
# E2E用バックエンドの待受ポート（5100固定）
PORT=5100

# メールの送信者名・件名・本文に使うアプリ名
VUE_APP_APPNAME="E2E ISeee TimeLine"
# メール内のリンクや通知に使うE2E用フロントエンドのURL（固定）
VUE_APP_APPURL=http://localhost:3100

# 環境に合わせる項目: E2E専用MongoDBのホストとポート
# ホストはdb、localhost、127.0.0.1、[::1]のいずれか。DB名はiseeetl_e2e固定、認証情報は含めない。
# 同じサーバでMongoDBを動かす例: mongodb://127.0.0.1:27017/iseeetl_e2e
DB_CONNECT=mongodb://db:27017/iseeetl_e2e?directConnection=true

# 通常ユーザのJWT署名・検証に使う公開ダミー鍵
JWT_SECRET=e2e-only-user-jwt-dummy-secret
# 通常ユーザのJWT有効期間（例: 30dは30日）
JWT_EXPIRES_IN=30d
# v1 API用のJWT署名・検証に使う公開ダミー鍵
JWT_DEV_SECRET=e2e-only-v1-jwt-dummy-secret
# ゲストのアクセストークン署名・検証に使う公開ダミー鍵
GUEST_JWT_SECRET=e2e-only-guest-access-dummy-secret
# ゲストのリフレッシュトークン署名・検証に使う公開ダミー鍵
GUEST_REFRESH_SECRET=e2e-only-guest-refresh-dummy-secret
# ゲストのアクセストークン有効期間（秒）
GUEST_ACCESS_TTL=900
# ゲストのリフレッシュトークン有効期間（秒）
GUEST_REFRESH_TTL=2592000

# 本登録用トークンの有効期間（分）
SIGNUP_TOKEN_TTL_MINUTES=60
# パスワード再設定用トークンの有効期間（分）
RESET_TOKEN_TTL_MINUTES=60
# LINEログイン時の一時Cookie有効期間（ミリ秒）
LINE_OAUTH_COOKIE_TTL_MS=600000
# ログイン失敗回数を集計する時間枠（ミリ秒）
LOGIN_RATE_LIMIT_WINDOW_MS=900000
# 時間枠内で許可するIPごとのログイン失敗回数
LOGIN_RATE_LIMIT_MAX=1000
# パスワード再設定メールの要求回数を集計する時間枠（ミリ秒）
RESET_MAIL_RATE_LIMIT_WINDOW_MS=3600000
# 時間枠内で許可するメールアドレスごとの再設定メール要求回数
RESET_MAIL_RATE_LIMIT_MAX=1000
# 時間枠内で許可するIPごとの再設定メール要求回数
RESET_MAIL_IP_RATE_LIMIT_MAX=1000

# HTTP APIへのアクセスを許可するE2E用フロントエンドのオリジン（固定）
CORS_ALLOWED_ORIGINS=http://localhost:3100
# Socket.IOへの接続を許可するE2E用フロントエンドのオリジン（固定）
SOCKET_CORS_ALLOWED_ORIGINS=http://localhost:3100

# 保存先は固定。backend/からの相対パスのため、チェックアウト先の絶対パスへの書換えは不要。
# 手順に従ってリポジトリ直下の.e2e-runtime/mediaとprofileを作成し、書込権限を用意する。
# E2E用フロントエンドのビルド成果物の参照先
DIST_PATH=../.e2e-runtime/frontend-dist
# タイムライン・フロア・ルームのメディア保存先
MEDIA_PATH=../.e2e-runtime/media
# プロフィール画像の保存先
PROFILE_PATH=../.e2e-runtime/profile

# mailプロファイルで使う専用Mailpit。同じサーバに置く場合はホストを127.0.0.1などへ変更する。
# ホストはmailpit・localhost・127.0.0.1・::1。SMTP 1025、HTTP API 8025のポートは固定。
# 他の環境と共有せず、外部SMTPへのリレー・転送を設定しない。送信元はexample.invalidを使う。
# メールの送信先となるMailpitのSMTPホスト
SEND_MAIL_HOST=mailpit
# MailpitのSMTPポート
SEND_MAIL_PORT=1025
# テストメールの送信元アドレス（example.invalidのダミー値）
NO_REPLY_MAIL=e2e-noreply@example.invalid
# テストから受信メールを確認・削除するMailpit APIのURL。IPv6の例: http://[::1]:8025
# 認証情報・パス・クエリ・フラグメントは含めない。
E2E_MAILPIT_API_URL=http://mailpit:8025

# DB初期化で作成する固定アカウント。実在する利用者の情報は設定しない。
# メールはexample.invalid、パスワードは8～16文字の公開ダミー値を使う。
# 管理者のユーザ名
E2E_ADMIN_USERNAME="E2E Administrator"
# 管理者のメールアドレス
E2E_ADMIN_MAIL=e2e-admin@example.invalid
# 管理者のパスワード
E2E_ADMIN_PASSWORD=e2e-admin-pass
# フロア編集者のユーザ名
E2E_FLOOR_EDITOR_USERNAME="E2E Editor"
# フロア編集者のメールアドレス
E2E_FLOOR_EDITOR_MAIL=e2e-editor@example.invalid
# フロア編集者のパスワード
E2E_FLOOR_EDITOR_PASSWORD=e2e-editor-pass
# 一般ユーザのユーザ名
E2E_USER_USERNAME="E2E Author"
# 一般ユーザのメールアドレス
E2E_USER_MAIL=e2e-author@example.invalid
# 一般ユーザのパスワード
E2E_USER_PASSWORD=e2e-author-pass

# このファイルの外部機能フラグはすべてfalse固定。
# 専用ローダーがプロファイルに応じてメール送信またはAnalyticsだけを有効にする。
# OpenAI解析・文字起こしの有効化
EXTERNAL_OPENAI_ENABLED=false
# Google Translateによる翻訳の有効化
EXTERNAL_GOOGLE_TRANSLATE_ENABLED=false
# Googleログインの有効化
EXTERNAL_GOOGLE_LOGIN_ENABLED=false
# LINEログインの有効化
EXTERNAL_LINE_LOGIN_ENABLED=false
# OneSignalのプッシュ通知の有効化
EXTERNAL_ONESIGNAL_ENABLED=false
# Google Analyticsの有効化（analyticsプロファイルの読込時だけ有効）
EXTERNAL_GOOGLE_ANALYTICS_ENABLED=false
# メール送信の有効化（mailプロファイルの読込時だけ有効）
EXTERNAL_MAIL_DELIVERY_ENABLED=false
# 外部サービスの認証情報は空値を維持する。実際のキーや資格情報は設定しない。
# GoogleログインのクライアントID
GOOGLE_OAUTH_CLIENT_ID=
# Google Translateの資格情報ファイルのパス
GOOGLE_APPLICATION_CREDENTIALS=
# Google Translateを使用するプロジェクトID
GOOGLE_PROJECT_ID=
# Google Translateの月間翻訳文字数上限（正の整数またはunlimited）
GOOGLE_TRANSLATE_API_LIMIT=0
# Google Translateの処理リージョン
GOOGLE_TRANSLATE_LOCATION=global
# LINEログインのチャネルID
LINE_LOGIN_CHANNEL_ID=
# LINEログインのチャネルシークレット
LINE_LOGIN_CHANNEL_SECRET=
# LINEログインのコールバックURL
LINE_LOGIN_REDIRECT_URI=
# OneSignalのアプリID
ONESIGNAL_APP_ID=
# OneSignalのREST API認証キー
ONESIGNAL_REST_API_KEYS=
# ユーザIDから通知用External IDを生成する専用秘密値
ONESIGNAL_EXTERNAL_ID_SECRET=
# OneSignal APIのホスト（空値では既定値を使用）
ONESIGNAL_HOST=
# OneSignal APIのポート（空値では既定値を使用）
ONESIGNAL_PORT=
# OneSignalの通知APIパス（空値では既定値を使用）
ONESIGNAL_PATH=
# OpenAI APIの認証キー
OPENAI_API_KEY=
# analyticsプロファイル専用。標準E2Eではローカルモックで検証する。
# Google Analyticsの測定ID（指定された公開ダミー値）
GA4_MEASUREMENT_ID=G-E2E0000000
# Google Analytics用の仮名ユーザIDを生成する鍵（指定された公開ダミー値）
GA4_USER_ID_SECRET=e2e-ga4-user-id-secret-public-dummy-0001
