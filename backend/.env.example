# バックエンド環境変数の共通設定例
# .env.development・.env.staging・.env.productionへコピーし、利用する環境の値を設定する。
# この設定例はGit管理に残し、実際の設定ファイルはGit管理しない。
# npm run devは.env.developmentを読み込む。

# 実行環境（開発はdevelopment、staging／productionはproduction）
NODE_ENV=development
PORT=5000

# アプリ基本情報
# メール送信時は送信者名、件名、本文に使用
VUE_APP_APPNAME=DEV ISeee TimeLine
# Backend起動時にHTTPまたはHTTPS URLとして検証する
VUE_APP_APPURL=http://localhost:3000

# DB接続（起動時必須）
DB_CONNECT=mongodb://db:27017/dbname

# 認証（起動時必須）
JWT_SECRET=replace-with-strong-secret
# JWTアクセストークンの有効期限（例: 30d / 12h）
JWT_EXPIRES_IN=30d
# 旧/開発向けAPI v1を利用する場合に必要（通常JWTと分離）
JWT_DEV_SECRET=replace-with-strong-dev-secret

# ゲスト認証（起動時必須）
GUEST_JWT_SECRET=replace-with-strong-guest-access-secret
GUEST_REFRESH_SECRET=replace-with-strong-guest-refresh-secret
# ゲストアクセストークンTTL（秒）
GUEST_ACCESS_TTL=900
# ゲストリフレッシュトークンTTL（秒）
GUEST_REFRESH_TTL=2592000

# トークン/クッキー/レート制限の調整
# 仮登録トークン有効期限（分）
SIGNUP_TOKEN_TTL_MINUTES=60
# パスワード再設定トークン有効期限（分）
RESET_TOKEN_TTL_MINUTES=60
# LINE OAuth state/nonce Cookie の保持時間（ミリ秒）
LINE_OAUTH_COOKIE_TTL_MS=600000
# ログインAPIの制限ウィンドウ（ミリ秒）
LOGIN_RATE_LIMIT_WINDOW_MS=900000
# ログインAPIの制限回数
LOGIN_RATE_LIMIT_MAX=20
# パスワード再設定メールAPIの制限ウィンドウ（ミリ秒）
RESET_MAIL_RATE_LIMIT_WINDOW_MS=3600000
# パスワード再設定メールAPIの制限回数
RESET_MAIL_RATE_LIMIT_MAX=5
# パスワード再設定メールAPIのIP単位制限回数
RESET_MAIL_IP_RATE_LIMIT_MAX=20

# CORS設定（カンマ区切り）
# API(CORS)許可オリジン。利用するフロントエンドのURLへ変更する
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Socket.IO許可オリジン（未設定時は CORS_ALLOWED_ORIGINS を使用）
SOCKET_CORS_ALLOWED_ORIGINS=http://localhost:3000

# パス設定（MEDIA_PATH / PROFILE_PATH は起動時必須）
# フロントエンドのビルド成果物配置先（productionでは必須。読取可能なindex.htmlを含める。永続データは置かない）
DIST_PATH=任意の場所
# 投稿メディア（画像/動画/音声）保存先（永続データ）
MEDIA_PATH=/var/lib/iseeetl/media/
# プロフィール画像保存先（永続データ）
PROFILE_PATH=/var/lib/iseeetl/profile/

# 外部連携
# 各機能は対応するEXTERNAL_*_ENABLEDをtrueにした場合だけ必須設定を検証して外部連携を行う

# メール
EXTERNAL_MAIL_DELIVERY_ENABLED=false
SEND_MAIL_HOST=localhost
SEND_MAIL_PORT=587
NO_REPLY_MAIL=info@example.local

# Google翻訳
EXTERNAL_GOOGLE_TRANSLATE_ENABLED=false
# サービスアカウントJSONへのパス（ADC）
GOOGLE_APPLICATION_CREDENTIALS=
# 翻訳APIを利用する場合のプロジェクトID
GOOGLE_PROJECT_ID=
# 翻訳APIロケーション
GOOGLE_TRANSLATE_LOCATION=global
# 月間上限文字数
GOOGLE_TRANSLATE_API_LIMIT=2000000

# Googleログイン
EXTERNAL_GOOGLE_LOGIN_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=

# Google Analytics
EXTERNAL_GOOGLE_ANALYTICS_ENABLED=false
# Web streamのMeasurement ID。形式は G- に続く英大文字または数字
GA4_MEASUREMENT_ID=
# User-ID用の専用秘密値（UTF-8換算で32バイト以上）
GA4_USER_ID_SECRET=

# LINEログイン
EXTERNAL_LINE_LOGIN_ENABLED=false
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# LINEコンソール登録のコールバックURLと一致させる
LINE_LOGIN_REDIRECT_URI=

# OpenAI解析・文字起こし
EXTERNAL_OPENAI_ENABLED=false
OPENAI_API_KEY=
# 有効時は5種すべて必須。変更後はバックエンドを再起動する
# 画像解析
OPENAI_VISION_MODEL=gpt-model-name
# 動画解析
OPENAI_VIDEO_MODEL=gpt-model-name
# 音声の状況解析
OPENAI_AUDIO_MODEL=gpt-model-name
# 投稿・返信本文の解析
OPENAI_CONVERSATION_MODEL=gpt-model-name
# 自動解析と通常操作の文字起こし
OPENAI_TRANSCRIPTION_MODEL=gpt-model-name
# AI解析設定の新規作成時に選択するユーザID。空欄なら初期選択なし
SUPPORT_USER_ID=

# OneSignal
EXTERNAL_ONESIGNAL_ENABLED=false
ONESIGNAL_HOST=onesignal.com
ONESIGNAL_PORT=443
ONESIGNAL_PATH=/api/v1/notifications
ONESIGNAL_REST_API_KEYS=
ONESIGNAL_APP_ID=
# User IDから通知用External IDを生成する専用秘密値（32バイト以上）
ONESIGNAL_EXTERNAL_ID_SECRET=
