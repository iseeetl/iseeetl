{
  "name": "iseeetl",
  "version": "2.0.4",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "NODE_ENV=development dotenv -e .env.development -- nodemon app.js",
    "dev:e2e": "node -r ./scripts/e2e/preload-core.js app.js",
    "dev:e2e:mail": "node -r ./scripts/e2e/preload-mail.js app.js",
    "dev:e2e:analytics": "node -r ./scripts/e2e/preload-analytics.js app.js",
    "e2e:db:reset": "node -r ./scripts/e2e/preload-core.js ./scripts/e2e/reset-database.js",
    "lint": "eslint .",
    "test:unit": "jest -c ./jest.unit.config.js",
    "test:int": "jest -c ./jest.integration.config.js --runInBand",
    "test:int:v1": "jest -c ./jest.integration.config.js --runInBand tests/integration/routes/v1.route.int.test.js tests/integration/routes/v1.extended.route.int.test.js",
    "test:int:external-mocked": "node ./scripts/run-integration-group.js external-mocked",
    "test:int:remaining": "node ./scripts/run-integration-group.js remaining",
    "test": "npm run test:unit && npm run test:int"
  },
  "dependencies": {
    "@google-cloud/translate": "^10.1.0",
    "archiver": "^5.3.1",
    "axios": "^1.20.0",
    "bcrypt": "6.0.0",
    "bluebird": "^3.5.3",
    "connect-history-api-fallback": "^1.5.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^8.1.0",
    "dotenv-cli": "^6.0.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^6.4.0",
    "fluent-ffmpeg": "2.1.2",
    "google-auth-library": "^10.4.0",
    "http-proxy-agent": "^2.1.0",
    "https-proxy-agent": "^2.2.4",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.24.0",
    "moment-timezone": "^0.5.23",
    "mongo-sanitize": "^1.0.1",
    "mongodb": "^5.9.2",
    "mongoose": "^7.8.8",
    "mongoose-paginate-v2": "1.9.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.1.1",
    "rimraf": "^2.6.3",
    "sharp": "^0.35.4",
    "socket.io": "^4.0.0",
    "validator": "13.15.26"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.24.4",
    "babel-jest": "^30.5.1",
    "chai": "^4.1.2",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "jest": "^30.5.1",
    "mongodb-memory-server": "^10.2.0",
    "nodemailer-mock": "^2.0.5",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.3"
  }
}
